{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "msgblast-download",
  "main": "worker.mjs",
  "account_id": "659c439216958cf1ab948ef03342ad18",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "updates.msgblast.app/latest.zip*", "zone_name": "msgblast.app" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
